<UserControl x:Class="PeluqueriaAdmin.App.Views.InventoryView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:viewModels="clr-namespace:PeluqueriaAdmin.App.ViewModels"
  d:DataContext="{d:DesignInstance Type=viewModels:InventoryViewModel, IsDesignTimeCreatable=False}"
  d:DesignHeight="760"
  d:DesignWidth="1180"
  Language="es-CO"
  mc:Ignorable="d">
  <UserControl.Resources>
    <Style x:Key="FieldBox" TargetType="Control">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="8,4" />
    </Style>
    <Style x:Key="FormLabel" TargetType="TextBlock">
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Margin" Value="0,0,0,3" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#273449" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>
  </UserControl.Resources>

  <Grid Margin="18" Background="#F5F7FA">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Margin="0,0,0,8">
      <TextBlock FontSize="28" FontWeight="SemiBold" Text="Inventario" />
      <TextBlock Margin="0,5,0,0"
                 Foreground="#5B6575"
                 Text="Productos comprados, existencias y registro completo de movimientos." />
    </StackPanel>

    <TextBlock Grid.Row="1"
               Margin="2,0,0,6"
               AutomationProperties.LiveSetting="Polite"
               Text="{Binding StatusMessage}"
               TextWrapping="Wrap">
      <TextBlock.Style>
        <Style TargetType="TextBlock">
          <Setter Property="Foreground" Value="#0F766E" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsError}" Value="True">
              <Setter Property="Foreground" Value="#B91C1C" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </TextBlock.Style>
    </TextBlock>

    <TabControl x:Name="InventoryTabs" Grid.Row="2" SelectedIndex="0">
      <TabItem Header="Inventario actual">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="8">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Border Grid.Row="0"
                  Margin="0,0,0,7"
                  Padding="10"
                  Background="White"
                  BorderBrush="#D7DEE8"
                  BorderThickness="1"
                  CornerRadius="7"
                  Visibility="{Binding ShowInventoryAddForm, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Margin="0,0,0,6"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Text="Agregar producto desde la lista de compra" />
                <WrapPanel>
                  <StackPanel Width="230" Margin="0,0,10,7">
                    <TextBlock Style="{StaticResource FormLabel}"
                               Text="Producto previamente añadido a la lista de compra" />
                    <Grid>
                      <ComboBox Style="{StaticResource FieldBox}"
                                AutomationProperties.Name="Buscar producto en la lista de compra"
                                IsDropDownOpen="{Binding IsMonthlyPurchaseDropDownOpen, Mode=TwoWay}"
                                IsEditable="True"
                                IsTextSearchEnabled="False"
                                ItemsSource="{Binding PendingMonthlyPurchaseRows}"
                                SelectedItem="{Binding SelectedPendingMonthlyPurchaseRow, Mode=TwoWay}"
                                StaysOpenOnEdit="True"
                                Text="{Binding MonthlyPurchaseSearchText, UpdateSourceTrigger=PropertyChanged}"
                                TextSearch.TextPath="Product">
                        <ComboBox.ItemTemplate>
                          <DataTemplate>
                            <StackPanel>
                              <TextBlock FontWeight="SemiBold" Text="{Binding Product}" />
                              <TextBlock FontSize="11" Foreground="#64748B">
                                <Run Text="{Binding Category}" />
                                <Run Text=" · Cantidad esperada: " />
                                <Run Text="{Binding Quantity}" />
                                <Run Text=" · " />
                                <Run Text="{Binding UnitPrice}" />
                              </TextBlock>
                            </StackPanel>
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                      <Path Width="16"
                            Height="16"
                            Margin="0,0,31,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Data="M 7,1 A 6,6 0 1 0 7,13 A 6,6 0 1 0 7,1 M 11.2,11.2 L 16,16"
                            IsHitTestVisible="False"
                            Stretch="Uniform"
                            Stroke="#64748B"
                            StrokeThickness="1.8" />
                    </Grid>
                    <TextBlock Margin="2,5,0,0"
                               Foreground="#B91C1C"
                               Text="No hay productos pendientes en la lista de compra"
                               Visibility="{Binding HasNoPendingMonthlyPurchases, Converter={StaticResource BooleanToVisibilityConverter}}" />
                  </StackPanel>

                  <StackPanel Width="110" Margin="0,0,10,7">
                    <TextBlock Style="{StaticResource FormLabel}" Text="Fecha agregada" />
                    <DatePicker Style="{StaticResource FieldBox}" SelectedDate="{Binding Editor.FormDate}" />
                  </StackPanel>

                  <StackPanel Width="115" Margin="0,0,10,7">
                    <TextBlock Style="{StaticResource FormLabel}" Text="Cantidad comprada" />
                    <TextBox Style="{StaticResource FieldBox}"
                             Text="{Binding Editor.QuantityText, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>

                  <StackPanel Width="140" Margin="0,0,10,7">
                    <TextBlock Style="{StaticResource FormLabel}" Text="Precio de venta" />
                    <TextBox Style="{StaticResource FieldBox}"
                             IsEnabled="{Binding SelectedPendingMonthlyPurchaseRow.RequiresSalePrice, TargetNullValue=False, FallbackValue=False}"
                             Text="{Binding Editor.AmountText, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>

                  <StackPanel Width="200" Margin="0,0,10,7">
                    <TextBlock Style="{StaticResource FormLabel}" Text="Descripción para inventario" />
                    <TextBox MinHeight="42"
                             Padding="9,6"
                             Text="{Binding Editor.OptionalDescriptionText, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap" />
                  </StackPanel>
                </WrapPanel>

                <Border Margin="0,0,0,6"
                        Padding="7"
                        Background="#F8FAFC"
                        BorderBrush="#D7DEE8"
                        BorderThickness="1"
                        CornerRadius="5">
                  <TextBlock Foreground="#475569"
                             Text="{Binding SelectedMonthlyPurchaseSummaryText}"
                             TextWrapping="Wrap" />
                </Border>

                <Button Padding="15,8"
                        HorizontalAlignment="Left"
                        Background="#2E5BFF"
                        Command="{Binding RegisterMonthlyPurchaseCommand}"
                        Content="Agregar al inventario actual"
                        Foreground="White" />
            </StackPanel>
          </Border>

          <Border Grid.Row="0"
                  Margin="0,0,0,7"
                  Padding="10"
                  Background="White"
                  BorderBrush="#D7DEE8"
                  BorderThickness="1"
                  CornerRadius="7"
                  Visibility="{Binding IsEditingInventorySelection, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Margin="0,0,0,6"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Text="Editar selección del inventario" />
                <WrapPanel>
                  <StackPanel Width="220" Margin="0,0,12,8">
                    <TextBlock Style="{StaticResource FormLabel}" Text="Producto" />
                    <TextBox Style="{StaticResource FieldBox}"
                             Text="{Binding InventoryEditName, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                  <StackPanel Width="260" Margin="0,0,12,8">
                    <TextBlock Style="{StaticResource FormLabel}" Text="Categoría" />
                    <ComboBox Style="{StaticResource FieldBox}"
                              IsEditable="False"
                              ItemsSource="{Binding ProductCategoryOptions}"
                              SelectedItem="{Binding InventoryEditCategory}" />
                  </StackPanel>
                  <StackPanel Width="150" Margin="0,0,12,8">
                    <TextBlock Style="{StaticResource FormLabel}" Text="Cantidad esperada" />
                    <TextBox Style="{StaticResource FieldBox}"
                             Text="{Binding InventoryEditExpectedQuantity, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                  <StackPanel Width="220" Margin="0,0,12,8">
                    <TextBlock Style="{StaticResource FormLabel}" Text="Precio unitario o por paquete" />
                    <TextBox Style="{StaticResource FieldBox}"
                             Text="{Binding InventoryEditExpectedUnitCost, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                  <StackPanel Width="320" Margin="0,0,12,8">
                    <TextBlock Style="{StaticResource FormLabel}" Text="Descripción de la lista" />
                    <TextBox MinHeight="42"
                             Padding="9,6"
                             Text="{Binding InventoryEditListDescription, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel Width="110" Margin="0,0,8,7">
                    <TextBlock Style="{StaticResource FormLabel}" Text="Fecha agregada" />
                    <DatePicker Style="{StaticResource FieldBox}" SelectedDate="{Binding InventoryEditDate}" />
                  </StackPanel>
                  <StackPanel Width="125" Margin="0,0,8,7">
                    <TextBlock Style="{StaticResource FormLabel}" Text="Cantidad comprada" />
                    <TextBox Style="{StaticResource FieldBox}"
                             Text="{Binding InventoryEditPurchasedQuantity, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                  <StackPanel Width="140" Margin="0,0,8,7">
                    <TextBlock Style="{StaticResource FormLabel}" Text="Precio de venta" />
                    <TextBox Style="{StaticResource FieldBox}"
                             IsEnabled="{Binding InventoryEditRequiresSalePrice}"
                             Text="{Binding InventoryEditSalePrice, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                  <StackPanel Width="205" Margin="0,0,8,7">
                    <TextBlock Style="{StaticResource FormLabel}" Text="Descripción para inventario" />
                    <TextBox MinHeight="42"
                             Padding="9,6"
                             Text="{Binding InventoryEditDescription, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap" />
                  </StackPanel>
                </WrapPanel>
                <WrapPanel>
                  <Button Margin="0,0,8,0"
                          Padding="14,8"
                          Background="#2E5BFF"
                          Command="{Binding SaveInventorySelectionEditCommand}"
                          Content="Guardar cambios"
                          Foreground="White" />
                  <Button Padding="14,8"
                          Command="{Binding CancelInventorySelectionEditCommand}"
                          Content="Cancelar" />
                </WrapPanel>
            </StackPanel>
          </Border>

          <DockPanel Grid.Row="1" Margin="0,0,0,5">
            <Button Padding="13,7"
                    DockPanel.Dock="Left"
                    Command="{Binding EditInventorySelectionCommand}"
                    Content="Editar selección" />
            <TextBlock Margin="12,8,0,0"
                       Foreground="#64748B"
                       Text="Selecciona una fila de la tabla para modificar sus datos." />
          </DockPanel>

          <DataGrid x:Name="InventoryCurrentGrid"
                    Grid.Row="2"
                    Height="330"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    IsReadOnly="True"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    ItemsSource="{Binding CurrentInventory}"
                    SelectedItem="{Binding SelectedCurrentRow}">
            <DataGrid.Columns>
              <DataGridTextColumn Width="180" Binding="{Binding Name}" Header="Producto" />
              <DataGridTextColumn Width="180" Binding="{Binding Category}" Header="Categoría" />
              <DataGridTextColumn Width="135" Binding="{Binding ExpectedQuantity}" Header="Cantidad esperada" />
              <DataGridTextColumn Width="185" Binding="{Binding ExpectedUnitCost}" Header="Precio unitario o paquete" />
              <DataGridTextColumn Width="260" Binding="{Binding ListDescription}" ElementStyle="{StaticResource WrappingCellText}" Header="Descripción de la lista" />
              <DataGridTextColumn Width="145" Binding="{Binding PurchasedQuantity}" Header="Cantidad comprada" />
              <DataGridTextColumn Width="145" Binding="{Binding ActualUnitCost}" Header="Costo unitario real" />
              <DataGridTextColumn Width="145" Binding="{Binding ActualTotal}" Header="Total comprado" />
              <DataGridTextColumn Width="135" Binding="{Binding CurrentQuantity}" Header="Existencia actual" />
              <DataGridTextColumn Width="155" Binding="{Binding CurrentValue}" Header="Valor inventario actual" />
              <DataGridTextColumn Width="145" Binding="{Binding SalePrice}" Header="Precio de venta" />
              <DataGridTextColumn Width="260" Binding="{Binding InventoryDescription}" ElementStyle="{StaticResource WrappingCellText}" Header="Descripción de inventario" />
              <DataGridTextColumn Width="135" Binding="{Binding AddedDate}" Header="Fecha agregada" />
              <DataGridTextColumn Width="155" Binding="{Binding LastUpdated}" Header="Última actualización" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Movimientos">
        <Grid Margin="8">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0"
                      Margin="0,0,0,8"
                      HorizontalAlignment="Right"
                      Orientation="Horizontal">
            <TextBlock Margin="0,8,8,0" FontWeight="SemiBold" Text="Periodo" />
            <ComboBox Width="185"
                      Style="{StaticResource FieldBox}"
                      ItemsSource="{Binding PeriodOptions}"
                      SelectedItem="{Binding SelectedPeriod}" />
            <DatePicker Width="135"
                        Margin="8,0,0,0"
                        SelectedDate="{Binding CustomPeriodFrom}"
                        Visibility="{Binding ShowCustomPeriod, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <DatePicker Width="135"
                        Margin="8,0,0,0"
                        SelectedDate="{Binding CustomPeriodThrough}"
                        Visibility="{Binding ShowCustomPeriod, Converter={StaticResource BooleanToVisibilityConverter}}" />
          </StackPanel>

          <DataGrid x:Name="MovementHistoryGrid"
                    Grid.Row="1"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    IsReadOnly="True"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    ItemsSource="{Binding MovementHistory}">
            <DataGrid.Columns>
              <DataGridTextColumn Width="110" Binding="{Binding Date}" Header="Fecha" />
              <DataGridTextColumn Width="190" Binding="{Binding Product}" Header="Producto" />
              <DataGridTextColumn Width="180" Binding="{Binding Type}" Header="Movimiento" />
              <DataGridTextColumn Width="120" Binding="{Binding QuantityIn}" Header="Entrada" />
              <DataGridTextColumn Width="120" Binding="{Binding QuantityOut}" Header="Salida" />
              <DataGridTextColumn Width="145" Binding="{Binding UnitCost}" Header="Costo unitario" />
              <DataGridTextColumn Width="145" Binding="{Binding TotalValue}" Header="Valor total" />
              <DataGridTextColumn Width="300" Binding="{Binding Description}" ElementStyle="{StaticResource WrappingCellText}" Header="Descripción" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>

      <TabItem Header="Lista mensual de compra">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Border Grid.Row="0"
                  Margin="0,0,0,8"
                  Padding="10"
                    Background="White"
                    BorderBrush="#D7DEE8"
                    BorderThickness="1"
                    CornerRadius="7">
              <StackPanel>
                <TextBlock Margin="0,0,0,5"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Text="Añadir producto a la lista de compra" />
                <WrapPanel>
                  <StackPanel Width="220" Margin="0,0,12,8">
                    <TextBlock Style="{StaticResource FormLabel}" Text="Producto" />
                    <TextBox x:Name="MonthlyPurchaseProductBox" Style="{StaticResource FieldBox}"
                             Text="{Binding MonthlyPurchaseName, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                  <StackPanel Width="260" Margin="0,0,12,8">
                    <TextBlock Style="{StaticResource FormLabel}" Text="Categoría" />
                    <ComboBox x:Name="MonthlyPurchaseCategoryBox" Style="{StaticResource FieldBox}"
                              IsEditable="False"
                              ItemsSource="{Binding ProductCategoryOptions}"
                              SelectedItem="{Binding SelectedMonthlyPurchaseCategory}" />
                  </StackPanel>
                  <StackPanel Width="150" Margin="0,0,12,8">
                    <TextBlock Style="{StaticResource FormLabel}" Text="Cantidad esperada" />
                    <TextBox Style="{StaticResource FieldBox}"
                             Text="{Binding MonthlyPurchaseQuantity, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                  <StackPanel Width="220" Margin="0,0,12,8">
                    <TextBlock Style="{StaticResource FormLabel}" Text="Precio unitario o por paquete" />
                    <TextBox Style="{StaticResource FieldBox}"
                             Text="{Binding MonthlyPurchaseUnitCost, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                  <StackPanel Width="320" Margin="0,0,12,8">
                    <TextBlock Style="{StaticResource FormLabel}" Text="Descripción" />
                    <TextBox MinHeight="42"
                             Padding="9,6"
                             Text="{Binding MonthlyPurchaseDescription, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap" />
                  </StackPanel>
                </WrapPanel>

                <Border Margin="0,2,0,6"
                        Padding="7"
                        Background="#EEF2FF"
                        BorderBrush="#C7D2FE"
                        BorderThickness="1"
                        CornerRadius="5">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Left"
                               FontWeight="SemiBold"
                               Text="Precio total esperado" />
                    <TextBlock HorizontalAlignment="Right"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Text="{Binding MonthlyPurchaseExpectedTotalText}" />
                  </DockPanel>
                </Border>

                <WrapPanel>
                  <Button Margin="0,0,8,8"
                          Padding="13,7"
                          Command="{Binding AddMonthlyPurchaseCommand}"
                          Content="Agregar" />
                  <Button Margin="0,0,8,8"
                          Padding="13,7"
                          Command="{Binding EditMonthlyPurchaseCommand}"
                          Content="Editar selección" />
                  <Button Margin="0,0,8,8"
                          Padding="13,7"
                          Command="{Binding SaveMonthlyPurchaseEditCommand}"
                          Content="Guardar cambios" />
                  <CheckBox Margin="8,8,8,8"
                            IsChecked="{Binding ConfirmMonthlyPurchaseDelete}"
                            Content="Confirmo eliminar" />
                  <Button Margin="0,0,0,8"
                          Padding="13,7"
                          Command="{Binding DeleteMonthlyPurchaseCommand}"
                          Content="Eliminar" />
                </WrapPanel>
              </StackPanel>
          </Border>

          <DataGrid x:Name="MonthlyPurchaseGrid"
                    Grid.Row="1"
                    Height="330"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    IsReadOnly="True"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    ItemsSource="{Binding MonthlyPurchaseRows}"
                    SelectedItem="{Binding SelectedMonthlyPurchaseRow}">
            <DataGrid.Columns>
              <DataGridTextColumn Width="190" Binding="{Binding Product}" Header="Producto" />
              <DataGridTextColumn Width="180" Binding="{Binding Category}" Header="Categoría" />
              <DataGridTextColumn Width="135" Binding="{Binding Quantity}" Header="Cantidad esperada" />
              <DataGridTextColumn Width="190" Binding="{Binding UnitPrice}" Header="Precio unitario o por paquete" />
              <DataGridTextColumn Width="170" Binding="{Binding TotalExpected}" Header="Precio total esperado" />
              <DataGridTextColumn Width="300" Binding="{Binding Description}" ElementStyle="{StaticResource WrappingCellText}" Header="Descripción" />
              <DataGridTextColumn Width="145" Binding="{Binding ActualQuantity}" Header="Cantidad comprada" />
              <DataGridTextColumn Width="155" Binding="{Binding ActualUnitPrice}" Header="Costo unitario real" />
              <DataGridTextColumn Width="155" Binding="{Binding ActualTotal}" Header="Total real" />
              <DataGridTextColumn Width="145" Binding="{Binding CurrentQuantity}" Header="Existencia actual" />
              <DataGridTextColumn Width="160" Binding="{Binding State}" Header="Estado" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
