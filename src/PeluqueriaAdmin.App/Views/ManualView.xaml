<UserControl x:Class="PeluqueriaAdmin.App.Views.ManualView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:PeluqueriaAdmin.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewModels:ManualViewModel, IsDesignTimeCreatable=True}"
             d:DesignHeight="760"
             d:DesignWidth="990"
             mc:Ignorable="d">
  <Grid Margin="26" Background="#F5F7FA">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Margin="0,0,0,14">
      <TextBlock FontSize="28"
                 FontWeight="SemiBold"
                 Foreground="#172033"
                 Text="Manual" />
      <TextBlock Margin="0,5,0,0"
                 Foreground="#5B6575"
                 Text="Guía completa de operación, cálculos, datos, copias y actualizaciones." />
    </StackPanel>

    <Border Grid.Row="1"
            Background="White"
            BorderBrush="#D8DFEA"
            BorderThickness="1"
            CornerRadius="8">
      <FlowDocumentScrollViewer x:Name="ManualDocumentViewer"
                                IsToolBarVisible="False"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled">
        <FlowDocument PagePadding="26"
                      ColumnWidth="100000"
                      FontFamily="Segoe UI"
                      FontSize="14"
                      Foreground="#273247">
          <FlowDocument.Resources>
            <Style x:Key="SectionTitle" TargetType="{x:Type Paragraph}">
              <Setter Property="FontSize" Value="20" />
              <Setter Property="FontWeight" Value="SemiBold" />
              <Setter Property="Foreground" Value="#172033" />
              <Setter Property="Margin" Value="0,22,0,8" />
            </Style>
            <Style x:Key="SubTitle" TargetType="{x:Type Paragraph}">
              <Setter Property="FontSize" Value="16" />
              <Setter Property="FontWeight" Value="SemiBold" />
              <Setter Property="Foreground" Value="#2448C8" />
              <Setter Property="Margin" Value="0,12,0,5" />
            </Style>
            <Style TargetType="{x:Type Paragraph}">
              <Setter Property="LineHeight" Value="22" />
              <Setter Property="Margin" Value="0,0,0,8" />
            </Style>
            <Style TargetType="{x:Type List}">
              <Setter Property="Margin" Value="22,0,0,10" />
            </Style>
          </FlowDocument.Resources>

          <Paragraph FontSize="16"
                     FontWeight="SemiBold"
                     Foreground="#0F766E"
                     Margin="0,0,0,12">
            Este manual es informativo y forma parte del programa. Consultarlo no crea registros,
            no cambia cálculos y no modifica la base de datos.
          </Paragraph>
          <Paragraph FontWeight="SemiBold" Foreground="#475569">
            Versión documentada: 0.2.0-alpha.1.
          </Paragraph>

          <Paragraph Style="{StaticResource SubTitle}">Índice</Paragraph>
          <Paragraph LineHeight="25">
            <Hyperlink NavigateUri="#Inicio" RequestNavigate="NavigateToSection">1. Inicio</Hyperlink><LineBreak />
            <Hyperlink NavigateUri="#UsoDelLocal" RequestNavigate="NavigateToSection">2. Uso del local</Hyperlink><LineBreak />
            <Hyperlink NavigateUri="#Colaboradores" RequestNavigate="NavigateToSection">3. Colaboradores</Hyperlink><LineBreak />
            <Hyperlink NavigateUri="#Ventas" RequestNavigate="NavigateToSection">4. Ventas</Hyperlink><LineBreak />
            <Hyperlink NavigateUri="#Inventario" RequestNavigate="NavigateToSection">5. Inventario</Hyperlink><LineBreak />
            <Hyperlink NavigateUri="#OtrosIngresos" RequestNavigate="NavigateToSection">6. Otros ingresos</Hyperlink><LineBreak />
            <Hyperlink NavigateUri="#Gastos" RequestNavigate="NavigateToSection">7. Gastos</Hyperlink><LineBreak />
            <Hyperlink NavigateUri="#Imprevistos" RequestNavigate="NavigateToSection">8. Imprevistos</Hyperlink><LineBreak />
            <Hyperlink NavigateUri="#Obligaciones" RequestNavigate="NavigateToSection">9. Obligaciones</Hyperlink><LineBreak />
            <Hyperlink NavigateUri="#Prestamos" RequestNavigate="NavigateToSection">10. Préstamos</Hyperlink><LineBreak />
            <Hyperlink NavigateUri="#Mantenimiento" RequestNavigate="NavigateToSection">11. Mantenimiento</Hyperlink><LineBreak />
            <Hyperlink NavigateUri="#ResumenMensual" RequestNavigate="NavigateToSection">12. Resumen mensual</Hyperlink><LineBreak />
            <Hyperlink NavigateUri="#Graficos" RequestNavigate="NavigateToSection">13. Gráficos</Hyperlink><LineBreak />
            <Hyperlink NavigateUri="#BalanceAnual" RequestNavigate="NavigateToSection">14. Balance anual</Hyperlink><LineBreak />
            <Hyperlink NavigateUri="#Ajustes" RequestNavigate="NavigateToSection">15. Ajustes</Hyperlink><LineBreak />
            <Hyperlink NavigateUri="#Notas" RequestNavigate="NavigateToSection">16. Notas</Hyperlink><LineBreak />
            <Hyperlink NavigateUri="#Manual" RequestNavigate="NavigateToSection">17. Manual</Hyperlink><LineBreak />
            <Hyperlink NavigateUri="#Autoguardado" RequestNavigate="NavigateToSection">18. Autoguardado y seguridad</Hyperlink><LineBreak />
            <Hyperlink NavigateUri="#Excel" RequestNavigate="NavigateToSection">19. Excel</Hyperlink><LineBreak />
            <Hyperlink NavigateUri="#Actualizaciones" RequestNavigate="NavigateToSection">20. Actualizaciones</Hyperlink>
          </Paragraph>

          <Paragraph Style="{StaticResource SubTitle}">Propósito y límites del programa</Paragraph>
          <Paragraph>
            Peluquería Admin es una herramienta interna para registrar el dinero propio del local,
            sus obligaciones, inventario, mantenimiento, financiación y resultados. Su moneda
            única es USD. No convierte monedas ni cambia valores existentes al actualizarse.
          </Paragraph>
          <List MarkerStyle="Disc">
            <ListItem><Paragraph>El programa no es un sistema contable, fiscal ni tributario oficial.</Paragraph></ListItem>
            <ListItem><Paragraph>No calcula impuestos legales ni presenta información ante autoridades.</Paragraph></ListItem>
            <ListItem><Paragraph>No registra clientes, proveedores, medios de pago, comprobantes ni los servicios personales prestados por los trabajadores.</Paragraph></ListItem>
            <ListItem><Paragraph>Los trabajadores usan sillas y pagan por usar el local. Los colaboradores son inversionistas y nunca ocupan sillas.</Paragraph></ListItem>
          </List>

          <Paragraph Style="{StaticResource SubTitle}">Reglas generales de uso</Paragraph>
          <Paragraph>
            Revise siempre la fecha visible antes de guardar. Las fechas representan el día real de
            la operación; los importes admiten como máximo dos decimales y las cantidades de
            inventario hasta tres. Un botón deshabilitado indica que falta una selección o que algún
            valor no es válido.
          </Paragraph>
          <List MarkerStyle="Disc">
            <ListItem><Paragraph>Un guardado correcto prepara el formulario para la operación siguiente.</Paragraph></ListItem>
            <ListItem><Paragraph>Un error conserva lo escrito para que pueda corregirse; no existe un control general para vaciar esos campos.</Paragraph></ListItem>
            <ListItem><Paragraph>Los formularios recuperables se guardan como borradores, pero un borrador nunca cuenta como una operación confirmada.</Paragraph></ListItem>
            <ListItem><Paragraph>Editar y eliminar son acciones distintas. Eliminar exige la confirmación visible y conserva el historial mediante eliminación lógica.</Paragraph></ListItem>
            <ListItem><Paragraph>Las tablas tienen columnas fijas y barras internas. Use sus barras para consultar columnas o filas que no caben en la pantalla.</Paragraph></ListItem>
          </List>

          <Paragraph x:Name="Inicio" Style="{StaticResource SectionTitle}">1. Inicio</Paragraph>
          <Paragraph>
            Inicio resume lo que requiere atención sin reemplazar los módulos donde se registran
            operaciones. Los valores se actualizan al entrar, después de una operación pertinente y
            al cambiar el día. La fecha actual usa el calendario local del equipo. En Movimientos del
            día, el selector de fecha y Consultar son el filtro disponible; las demás tarjetas muestran
            automáticamente el estado del mes actual.
          </Paragraph>
          <List MarkerStyle="Disc">
            <ListItem><Paragraph><Bold>Pagos pendientes:</Bold> servicios, impuestos, créditos, otras obligaciones, gastos recurrentes y cuotas de préstamos vencidas o exigibles. Las compras previstas y los mantenimientos se muestran en sus módulos propios.</Paragraph></ListItem>
            <ListItem><Paragraph><Bold>Uso del local:</Bold> muestra cada trabajador con deuda y su importe; los saldos a favor no se presentan como deuda.</Paragraph></ListItem>
            <ListItem><Paragraph><Bold>Punto de equilibrio:</Bold> muestra cuánto falta en el mes después de aplicar la misma fórmula usada por Resumen mensual.</Paragraph></ListItem>
            <ListItem><Paragraph><Bold>Precio sugerido por silla:</Bold> combina todos los gastos recurrentes, ingresos no provenientes de sillas y sillas ocupadas sin contar dos veces ningún importe.</Paragraph></ListItem>
            <ListItem><Paragraph><Bold>Campana de mantenimiento:</Bold> incluye mantenimientos vencidos, de hoy y futuros, con costo estimado y acceso directo a Mantenimiento.</Paragraph></ListItem>
            <ListItem><Paragraph><Bold>Movimientos del día:</Bold> consulta una fecha local y muestra hora, módulo, operación, entidad, importe y estado, de lo más reciente a lo más antiguo.</Paragraph></ListItem>
          </List>
          <Paragraph>
            Inicio no muestra inventario, ventas, gráficos ni tarjetas adicionales. Para corregir un
            dato, abra el módulo que originó la operación.
          </Paragraph>

          <Paragraph x:Name="UsoDelLocal" Style="{StaticResource SectionTitle}">2. Uso del local</Paragraph>
          <Paragraph>
            Este módulo administra sillas y trabajadores. Use <Bold>Añadir silla</Bold> para crear
            una silla individual y <Bold>Añadir trabajador</Bold> para registrar nombre, fecha de
            ingreso, descripción opcional y, si está disponible, una silla inicial. La silla no es
            obligatoria y puede asignarse después.
          </Paragraph>
          <Paragraph Style="{StaticResource SubTitle}">Cuenta semanal</Paragraph>
          <Paragraph>
            La cuenta comienza en cero. El primer cobro se genera el sábado inmediato y se calcula
            únicamente por los días usados desde la fecha de ingreso hasta ese sábado, contando ambos
            días. Por ejemplo, domingo a sábado son siete días y martes a sábado son cinco días.
          </Paragraph>
          <Paragraph>
            <Bold>Primera cuota = tarifa semanal × días usados ÷ 7.</Bold>
            El resultado se redondea al centavo. Con una tarifa de USD 12, ingresar un martes produce
            una primera cuota de USD 8,57; ingresar un domingo produce USD 12.
          </Paragraph>
          <Paragraph>
            Desde el domingo siguiente, cada periodo completo va de domingo a sábado y cobra la tarifa
            semanal completa. Registrar un pago no reinicia el ciclo. Las cuotas ya generadas conservan
            su importe y las futuras usan la tarifa vigente al inicio de cada periodo.
          </Paragraph>          <Paragraph Style="{StaticResource SubTitle}">Perfil del trabajador</Paragraph>
          <List MarkerStyle="Disc">
            <ListItem><Paragraph>Ábralo con doble clic para consultar datos, cuenta, tarifas, pagos, silla e historial.</Paragraph></ListItem>
            <ListItem><Paragraph>Se acepta cualquier pago positivo, incluso anticipado o superior a la deuda. El excedente cubre cuotas futuras en orden cronológico.</Paragraph></ListItem>
            <ListItem><Paragraph>La cuenta informa próxima cuota, próximo pago realmente requerido y cobertura estimada.</Paragraph></ListItem>
            <ListItem><Paragraph>Asignar, cambiar o retirar una silla no mezcla cuentas y no elimina al trabajador.</Paragraph></ListItem>
            <ListItem><Paragraph>Eliminar trabajador libera la silla, detiene cuotas futuras y conserva pagos, crédito e historial. Esta versión no realiza devoluciones automáticas.</Paragraph></ListItem>
          </List>

          <Paragraph x:Name="Colaboradores" Style="{StaticResource SectionTitle}">3. Colaboradores</Paragraph>
          <Paragraph>
            Los colaboradores aportan capital y participan en un fondo de ganancia; no son
            trabajadores, no usan sillas y sus aportes no son ventas ni otros ingresos operativos.
            Editar o eliminar un aporte conserva eventos históricos con el valor anterior y nuevo.
          </Paragraph>
          <Paragraph>
            El porcentaje global configurado crea primero el fondo:
            <Bold>fondo = máximo(resultado repartible, 0) × porcentaje global.</Bold>
            Después, cada participación interna se aplica sobre ese fondo. La suma activa puede ser
            menor, pero nunca mayor, que 100 %. La parte no asignada queda en el local.
          </Paragraph>
          <List MarkerStyle="Disc">
            <ListItem><Paragraph>Antes del cierre, el pago del mes es una proyección.</Paragraph></ListItem>
            <ListItem><Paragraph>Al cerrar el mes, porcentajes e importes quedan congelados.</Paragraph></ListItem>
            <ListItem><Paragraph>El colaborador recibe el valor completo pendiente de su asignación; no se registran pagos parciales arbitrarios.</Paragraph></ListItem>
            <ListItem><Paragraph>Si el resultado es cero o negativo, el fondo es cero y el colaborador nunca queda debiendo dinero.</Paragraph></ListItem>
          </List>

          <Paragraph x:Name="Ventas" Style="{StaticResource SectionTitle}">4. Ventas</Paragraph>
          <Paragraph>
            Ventas permite buscar por nombre, sin distinguir mayúsculas, únicamente productos de
            categorías vendibles. Al elegir uno se muestran existencia y precio predeterminado.
            Escriba cantidad y precio unitario; revise el total antes de confirmar.
          </Paragraph>
          <List MarkerStyle="Disc">
            <ListItem><Paragraph>No se permite vender más de la existencia disponible ni dejar inventario negativo.</Paragraph></ListItem>
            <ListItem><Paragraph>La venta reduce existencias y registra el ingreso bruto recibido.</Paragraph></ListItem>
            <ListItem><Paragraph>El costo promedio de lo vendido y el margen son informativos; no crean una segunda salida de caja.</Paragraph></ListItem>
            <ListItem><Paragraph>Los servicios personales de los trabajadores no se registran aquí.</Paragraph></ListItem>
            <ListItem><Paragraph>Ventas registradas es un historial de solo lectura. Esta versión no permite editar ni eliminar una venta desde esa pantalla; una corrección requiere revisar el movimiento original con soporte técnico para conservar inventario y caja consistentes.</Paragraph></ListItem>
          </List>

          <Paragraph x:Name="Inventario" Style="{StaticResource SectionTitle}">5. Inventario</Paragraph>
          <Paragraph>
            Inventario actual incorpora únicamente productos creados previamente en la
            <Bold>Lista mensual de compra</Bold>. Use la lupa de búsqueda, seleccione una fila pendiente
            y registre fecha agregada, cantidad comprada, precio de venta cuando la categoría sea
            vendible y descripción para inventario.
          </Paragraph>
          <Paragraph>
            La tabla combina nombre, categoría, cantidad esperada, precio unitario o por paquete y
            descripción de la lista con cantidad comprada, existencia actual, precio de venta,
            descripción de inventario y fecha agregada. El precio total esperado se consulta solo en
            la Lista mensual de compra y no se repite en Inventario actual.
          </Paragraph>
          <Paragraph>
            Cantidad esperada y precio esperado describen el plan. Total esperado = cantidad esperada ×
            precio unitario o por paquete. Al comprar, cantidad comprada es la entrada real y el costo
            real del movimiento = cantidad comprada × ese precio; puede corregir el precio al editar la
            selección vinculada. Existencia = entradas acumuladas − ventas y demás salidas. La compra
            real se incluye una sola vez en gastos y punto de equilibrio; el plan pendiente solo sirve
            como compromiso conocido hasta ser reemplazado por la compra.
          </Paragraph>
          <List MarkerStyle="Disc">
            <ListItem><Paragraph><Bold>Editar selección</Bold> permite modificar los datos de la lista y de la compra vinculada en una sola operación.</Paragraph></ListItem>
            <ListItem><Paragraph>La existencia actual continúa calculándose a partir de todas las entradas y salidas del producto.</Paragraph></ListItem>
            <ListItem><Paragraph>Movimientos es un historial de solo lectura; no permite corregir, guardar ni eliminar movimientos desde esa pestaña.</Paragraph></ListItem>
            <ListItem><Paragraph>Las categorías autorizadas siguen siendo alimento o bebida para venta, otro producto para venta, cortesía para clientes, aseo, insumo del local y otro producto del local.</Paragraph></ListItem>
          </List>

          <Paragraph Style="{StaticResource SubTitle}">Lista mensual de compra</Paragraph>
          <Paragraph>
            Esta lista reúne los productos que se desean comprar. No solicita fecha ni mes. Cada fila
            contiene producto, categoría, cantidad esperada, precio unitario o por paquete y
            descripción. La barra <Bold>Precio total esperado</Bold> se actualiza automáticamente:
            <Bold> cantidad esperada × precio unitario o por paquete.</Bold>
          </Paragraph>
          <Paragraph>
            Sus acciones son <Bold>Agregar, Editar, Guardar y Eliminar</Bold>. Editar selección carga
            una fila pendiente y Guardar cambios confirma la modificación. Eliminar exige confirmación
            y conserva la eliminación lógica. Cuando una fila ya fue agregada al inventario, se edita
            desde Inventario actual para mantener vinculados el producto, la lista y su movimiento.
          </Paragraph>

          <Paragraph x:Name="OtrosIngresos" Style="{StaticResource SectionTitle}">6. Otros ingresos</Paragraph>
          <Paragraph>
            Registre la fecha real, concepto, valor y descripción opcional. Use esta sección solo para
            dinero propio del local que no proviene de Ventas ni de Uso del local. Guardar lo incluye
            como ingreso operativo del mes; Editar selección corrige el registro y Eliminar selección
            exige confirmación y lo excluye de cálculos sin borrar su trazabilidad.
          </Paragraph>
          <Paragraph>
            Los aportes de colaboradores y los préstamos recibidos son financiación: aumentan la
            disponibilidad, pero no se registran aquí ni se convierten en ganancia.
          </Paragraph>

          <Paragraph x:Name="Gastos" Style="{StaticResource SectionTitle}">7. Gastos</Paragraph>
          <Paragraph>
            Registre fecha, concepto, categoría, valor y descripción del egreso ordinario. El valor
            reduce el resultado, aumenta el punto de equilibrio y forma parte del total gastado del
            mes. Editar sustituye los datos de la misma operación; eliminar exige confirmación y es
            lógico, por lo que el historial sigue disponible para auditoría y Excel.
          </Paragraph>
          <Paragraph>
            No duplique aquí una compra de inventario, un pago de obligación, mantenimiento o cuota
            de préstamo ya registrado en su módulo, porque cada uno ya alimenta la fórmula compartida.
          </Paragraph>

          <Paragraph x:Name="Imprevistos" Style="{StaticResource SectionTitle}">8. Imprevistos</Paragraph>
          <Paragraph>
            Imprevistos es para una salida extraordinaria no planificada, como un daño o reparación
            inesperada. Gastos es para egresos ordinarios. Ambos solicitan fecha, concepto, valor y
            descripción, permiten editar y eliminar lógicamente, y reducen resultado y punto de
            equilibrio una sola vez en la fecha registrada.
          </Paragraph>

          <Paragraph x:Name="Obligaciones" Style="{StaticResource SectionTitle}">9. Obligaciones</Paragraph>
          <Paragraph>
            Agregar obligación define un compromiso con nombre, tipo, recurrencia, vencimiento
            inicial, valor esperado y descripción. Los tipos disponibles son
            <Bold>Servicio, Impuesto, Crédito y Otra obligación</Bold>.
          </Paragraph>
          <Paragraph>
            Las recurrencias disponibles son <Bold>Sin recurrencia, Semanal, Mensual y Anual</Bold>.
            La recurrencia semanal avanza cada siete días desde el vencimiento inicial. La mensual
            conserva el día ancla: una obligación del día 31 usa el último día de un mes corto y
            vuelve al 31 cuando sea posible.
          </Paragraph>
          <List MarkerStyle="Disc">
            <ListItem><Paragraph>Registrar pago permite elegir la obligación y guardar fecha, valor real y descripción.</Paragraph></ListItem>
            <ListItem><Paragraph>El valor esperado sirve como previsión. Al registrar el pago real, la ocurrencia queda liquidada por ese valor, aunque sea diferente; no queda una diferencia ficticia pendiente.</Paragraph></ListItem>
            <ListItem><Paragraph>Servicios, impuestos, créditos y otras obligaciones exigibles aparecen en Pagos pendientes y afectan el punto de equilibrio e Inicio por la misma fórmula compartida.</Paragraph></ListItem>
            <ListItem><Paragraph>El tipo Crédito identifica una obligación de pago. No crea automáticamente un desembolso recibido ni un calendario de amortización.</Paragraph></ListItem>
            <ListItem><Paragraph>Editar obligación cambia el catálogo futuro; editar o eliminar un pago corrige su historial. Las eliminaciones exigen confirmación y permanecen en la trazabilidad.</Paragraph></ListItem>
          </List>

          <Paragraph x:Name="Prestamos" Style="{StaticResource SectionTitle}">10. Préstamos</Paragraph>
          <Paragraph>
            Los préstamos se administran dentro de Obligaciones, pero se diferencian de una
            obligación de tipo Crédito porque registran financiación recibida y un calendario exacto.
            El dinero recibido aumenta disponibilidad, no ingresos operativos ni ganancia.
          </Paragraph>
          <List MarkerStyle="Disc">
            <ListItem><Paragraph><Bold>Interés mensual sobre saldo:</Bold> calcula cuota fija y separa capital e interés de cada periodo.</Paragraph></ListItem>
            <ListItem><Paragraph><Bold>Interés fijo sobre capital inicial:</Bold> calcula cada interés mensual usando siempre el capital original y distribuye el capital entre las cuotas.</Paragraph></ListItem>
            <ListItem><Paragraph><Bold>Cantidad final acordada:</Bold> parte del capital y del total pactado y calcula interés total y tasa equivalente informativa.</Paragraph></ListItem>
            <ListItem><Paragraph>La vista previa muestra todas las fechas, cuota, capital, interés y saldo de capital antes de registrar.</Paragraph></ListItem>
            <ListItem><Paragraph>Todo se calcula en centavos enteros; la última cuota absorbe el residuo para coincidir exactamente con el total.</Paragraph></ListItem>
            <ListItem><Paragraph>Registrar cuota paga la siguiente cuota pendiente completa y vincula el pago a esa cuota.</Paragraph></ListItem>
            <ListItem><Paragraph>Antes del primer pago puede editarse todo el plan. Después, solo nombre y descripción. Los pagos de meses abiertos admiten corrección o eliminación lógica con recálculo; un mes cerrado debe reabrirse primero.</Paragraph></ListItem>
            <ListItem><Paragraph>Las cuotas vencidas o exigibles aparecen en Inicio y en la tabla única Pagos pendientes.</Paragraph></ListItem>
          </List>
          <Paragraph>
            <Bold>Ejemplo de cantidad final acordada:</Bold> si se reciben USD 1.000 y se pactan
            USD 1.500 en 25 cuotas, cada cuota es USD 60. El capital recibido es financiación,
            los USD 500 adicionales son el costo financiero total y el calendario distribuye
            capital e interés sin alterar el total pactado. La primera y última fecha delimitan
            el calendario; el saldo baja al registrar cada cuota completa.
          </Paragraph>

          <Paragraph x:Name="Mantenimiento" Style="{StaticResource SectionTitle}">11. Mantenimiento</Paragraph>
          <Paragraph>
            Programe el equipo o bien, tipo de mantenimiento, fecha prevista, costo estimado si se
            conoce, recurrencia y descripción. Completar mantenimiento registra fecha realizada y
            costo real. El estado se calcula; no se escribe manualmente.
          </Paragraph>
          <List MarkerStyle="Disc">
            <ListItem><Paragraph>Todo mantenimiento pendiente aparece en la campana de Inicio como vencido, de hoy o futuro.</Paragraph></ListItem>
            <ListItem><Paragraph>Un mantenimiento pendiente afecta el punto de equilibrio como gasto proyectado opcional y se mantiene separado de Pagos pendientes.</Paragraph></ListItem>
            <ListItem><Paragraph>Al realizarlo, el costo real sustituye la estimación sin contar el mantenimiento dos veces.</Paragraph></ListItem>
            <ListItem><Paragraph>Editar realizado corrige el historial y su costo sin generar una nueva recurrencia. Completar una recurrencia crea como máximo una siguiente ocurrencia.</Paragraph></ListItem>
            <ListItem><Paragraph>No se registran técnico, proveedor, ubicación, medio de pago ni comprobante.</Paragraph></ListItem>
          </List>

          <Paragraph x:Name="ResumenMensual" Style="{StaticResource SectionTitle}">12. Resumen mensual</Paragraph>
          <Paragraph>
            Resumen mensual es el único lugar que muestra el resumen financiero completo y permite
            cerrar un mes. Las deudas de trabajadores aparecen como Alquileres de silla pendientes.
            Los aportes y préstamos recibidos se muestran como financiación separada y no como ganancia.
          </Paragraph>
          <Paragraph>
            Las tarjetas de entrada separan saldo anterior, alquileres, ventas, otros ingresos, demás
            ingresos, aportes y financiación. Las de salida separan inventario, gastos, extraoficiales,
            imprevistos, servicios, impuestos, otras obligaciones, préstamos, créditos, mantenimiento,
            colaboradores pagados y demás salidas. Luego muestran total disponible, total gastado,
            punto de equilibrio, faltó o sobró y saldo siguiente.
          </Paragraph>
          <Paragraph>
            <Bold>Total disponible del mes = saldo trasladado + alquileres cobrados + ventas + otros ingresos reales.</Bold>
            <Bold> Total gastado y punto de equilibrio = inventario + gastos + gastos extraoficiales +
            imprevistos + servicios + impuestos + otras obligaciones + préstamos + créditos +
            mantenimiento + ganancias de colaboradores efectivamente pagadas + demás salidas.</Bold>
            Si Total disponible menos Total gastado es negativo se muestra cuánto faltó; si es positivo,
            cuánto sobró. La financiación se suma al saldo trasladado, pero no convierte el resultado en ganancia.
          </Paragraph>
          <Paragraph>
            <Bold>Ejemplo:</Bold> saldo anterior USD 1.205 + alquileres USD 42,86 + otros ingresos
            USD 450 = total disponible USD 1.697,86. Extraoficiales USD 45 + servicios USD 75 +
            préstamos USD 60 = total gastado USD 180. El saldo siguiente es
            1.697,86 − 180 = <Bold>USD 1.517,86</Bold>.
          </Paragraph>
          <List MarkerStyle="Disc">
            <ListItem><Paragraph><Bold>Ingreso operativo:</Bold> cobros reales por sillas, ventas y otros ingresos propios. <Bold>Financiación:</Bold> aportes y préstamos recibidos; aumenta caja, no ganancia. <Bold>Gasto:</Bold> salida real. <Bold>Compromiso pendiente:</Bold> importe conocido aún no pagado. <Bold>Saldo trasladado:</Bold> dinero que ya existía al comenzar el mes.</Paragraph></ListItem>
            <ListItem><Paragraph>Alquileres pendientes muestra cuotas de silla causadas y no pagadas. Pagos pendientes reúne obligaciones y cuotas exigibles conocidas.</Paragraph></ListItem>
            <ListItem><Paragraph>Antes de cerrar, complete importes faltantes o use Ignorar con un motivo obligatorio y después Guardar exclusiones.</Paragraph></ListItem>
            <ListItem><Paragraph>Guardar exclusiones conserva la razón; Cerrar mes congela cifras, fórmula, porcentajes y asignaciones.</Paragraph></ListItem>
            <ListItem><Paragraph><Bold>Ignorar un compromiso en el cierre no lo paga, no lo elimina y no cancela la deuda.</Bold> Solo permite cerrar ese mes sin incluirlo en la fotografía del cierre.</Paragraph></ListItem>
            <ListItem><Paragraph>Las obligaciones anuales se prorratean entre doce meses; diciembre absorbe cualquier centavo residual y el pago no vuelve a descontar el total.</Paragraph></ListItem>
            <ListItem><Paragraph>Los gastos recurrentes definidos en Ajustes afectan punto de equilibrio, resultado, pago calculado para colaboradores, Balance anual y gráficos desde su mes inicial.</Paragraph></ListItem>
            <ListItem><Paragraph>Reabrir exige confirmación, restaura el cálculo dinámico y se bloquea si ya se pagó una distribución.</Paragraph></ListItem>
            <ListItem><Paragraph>Un ajuste histórico a favor aparece con signo positivo cuando un snapshot cerrado necesita compensar una categoría vigente que no formó parte de esa fotografía. Reduce salidas; no debe sumarse como un gasto nuevo.</Paragraph></ListItem>
          </List>

          <Paragraph x:Name="Graficos" Style="{StaticResource SectionTitle}">13. Gráficos</Paragraph>
          <Paragraph>
            Resumen mensual incluye un pastel de ingresos, un pastel de gastos y líneas de ingresos
            frente a egresos. Cada color identifica una categoría y cada porción muestra su proporción;
            las líneas comparan importes por intervalo. Seleccione Día, Semana, Mes, Fecha específica
            o Año específico y use la fecha o el año de referencia cuando aparezca. Los gráficos
            usan los mismos movimientos que las tarjetas y no crean cálculos independientes.
          </Paragraph>
          <Paragraph>
            Balance anual muestra además ingresos frente a egresos por mes y dos pasteles de composición
            anual. Una categoría sin valor no genera porción. Pase el puntero por los elementos para
            leer la etiqueta y el valor; si el periodo no tiene datos, el gráfico permanece vacío.
          </Paragraph>

          <Paragraph x:Name="BalanceAnual" Style="{StaticResource SectionTitle}">14. Balance anual</Paragraph>
          <Paragraph>
            Seleccione únicamente un año de la lista. La vista siempre presenta enero a diciembre: un mes cerrado
            usa su fotografía histórica y uno abierto usa el cálculo vigente. Los gráficos utilizan
            exactamente las mismas cifras que las tarjetas.
          </Paragraph>
          <List MarkerStyle="Disc">
            <ListItem><Paragraph>El cierre anual requiere los doce meses cerrados, incluso meses con cero movimientos.</Paragraph></ListItem>
            <ListItem><Paragraph>Cerrar el año no elimina cierres anteriores y crea arrastres separados.</Paragraph></ListItem>
            <ListItem><Paragraph>Reabrir año exige confirmación, invalida su traslado y se bloquea si ya hay un año posterior cerrado.</Paragraph></ListItem>
            <ListItem><Paragraph>El resumen anual suma las categorías finales de los doce meses. Los meses futuros permanecen en cero.</Paragraph></ListItem>
            <ListItem><Paragraph>La tabla mensual muestra ingresos, gastos, punto de equilibrio, faltó o sobró y estado abierto o cerrado.</Paragraph></ListItem>
          </List>
          <Paragraph>
            Los pagos de préstamos son salidas: se incluyen una sola vez en el mes correspondiente,
            en el punto de equilibrio, en el resultado y en el saldo trasladado. El total anual es
            exactamente la suma de los doce totales mensuales; aportes y financiación recibida se
            presentan aparte de los ingresos operativos.
          </Paragraph>
          <Paragraph>
            <Bold>Ejemplo anual consistente:</Bold> ingresos operativos USD 1.692,86 menos gastos
            USD 715 = resultado USD 977,86. Si además existen USD 350 en aportes y USD 100 de
            financiación recibida, la disponibilidad resultante es
            977,86 + 450 = <Bold>USD 1.427,86</Bold>, siempre que no haya otro saldo previo.
          </Paragraph>

          <Paragraph x:Name="Ajustes" Style="{StaticResource SectionTitle}">15. Ajustes</Paragraph>
          <Paragraph>
            Ajustes contiene la tarifa semanal general, el porcentaje global de ganancia de
            colaboradores, la carpeta de exportación y gastos recurrentes. La moneda es siempre
            USD. Los cambios válidos se guardan automáticamente; un texto temporalmente inválido se
            conserva como borrador para corregirlo.
          </Paragraph>
          <List MarkerStyle="Disc">
            <ListItem><Paragraph>Cambiar la tarifa afecta cuotas futuras; no reescribe cuotas históricas.</Paragraph></ListItem>
            <ListItem><Paragraph>Cambiar el porcentaje no modifica cierres ya confirmados.</Paragraph></ListItem>
            <ListItem><Paragraph>Un gasto recurrente se descuenta una vez por mes desde su fecha inicial. Al eliminarlo se finaliza su vigencia y los meses históricos permanecen calculables y exportables.</Paragraph></ListItem>
            <ListItem><Paragraph>La sección Datos reúne copia, restauración y exportación Excel; Actualizaciones reúne búsqueda, descarga y aplicación.</Paragraph></ListItem>
            <ListItem><Paragraph>En Gastos extraoficiales, Agregar crea un importe mensual desde su fecha efectiva; Editar y Guardar edición corrigen nombre, valor o vigencia, y Eliminar finaliza su efecto sin destruir el historial anterior.</Paragraph></ListItem>
          </List>

          <Paragraph x:Name="Notas" Style="{StaticResource SectionTitle}">16. Notas</Paragraph>
          <Paragraph>
            Notas es un único bloc editable, sin límite configurado y sin ajuste automático de línea; use sus barras horizontal y vertical. Se guarda después de una pausa breve, al perder el foco
            y al cerrar. Su contenido vive en SQLite y forma parte de copias, restauración y Excel.
            No necesita pulsar Guardar. El programa no borra el texto automáticamente: para eliminarlo,
            selecciónelo y bórrelo manualmente; el autoguardado conservará el nuevo contenido.
          </Paragraph>

          <Paragraph x:Name="Manual" Style="{StaticResource SectionTitle}">17. Manual</Paragraph>
          <Paragraph>
            Use el índice del comienzo para saltar a un capítulo y la barra vertical para continuar
            leyendo o volver al inicio. Manual es documentación estática de la versión instalada. Leerlo no lo
            guarda en SQLite, no genera borradores ni movimientos y no cambia información. Cuando
            cambien funciones del programa, la siguiente versión actualizará también este manual.
          </Paragraph>

          <Paragraph x:Name="Autoguardado" Style="{StaticResource SectionTitle}">18. Autoguardado y seguridad</Paragraph>
          <Paragraph>
            Ajustes válidos, porcentajes editables, Notas y formularios recuperables se guardan
            automáticamente después de una pausa o al salir de la sección. Un borrador conserva campos
            incompletos después de un cierre inesperado, pero no afecta inventario, dinero ni reportes.
            Guardar operaciones, cerrar o reabrir periodos, eliminar registros, restaurar copias y
            aplicar actualizaciones requieren botones y, cuando corresponde, confirmación explícita.
          </Paragraph>
          <Paragraph>
            Una copia <Bold>.db</Bold> es la copia completa y restaurable de SQLite. Incluye tablas,
            relaciones, Notas, borradores, históricos, eliminados lógicamente y registros futuros.
            Es el medio adecuado para recuperar el programa, no el archivo Excel.
          </Paragraph>
          <List MarkerStyle="Disc">
            <ListItem><Paragraph><Bold>auto-</Bold>: como máximo una diaria cuando cambia la base; se conservan las 30 más recientes.</Paragraph></ListItem>
            <ListItem><Paragraph><Bold>manual-</Bold>: se crea con Ajustes, Datos, Crear copia ahora.</Paragraph></ListItem>
            <ListItem><Paragraph><Bold>pre-migration-</Bold>: protege el estado antes de una migración pendiente.</Paragraph></ListItem>
            <ListItem><Paragraph><Bold>pre-restore-</Bold>: protege el estado actual antes de restaurar otra copia.</Paragraph></ListItem>
          </List>
          <Paragraph>
            Para restaurar, seleccione una copia conocida, confirme la operación y espere el mensaje
            final. La aplicación valida compatibilidad, usa archivos temporales y recupera la base
            anterior si falla. Reinicie el programa después de una restauración correcta. No cierre
            Windows durante el reemplazo. No borre manualmente la base SQLite, sus archivos auxiliares
            ni la carpeta de copias: use las acciones del programa y conserve una copia externa conocida.
          </Paragraph>

          <Paragraph x:Name="Excel" Style="{StaticResource SectionTitle}">19. Excel</Paragraph>
          <Paragraph>
            Exportar toda la información a Excel crea un único archivo <Bold>.xlsx</Bold> legible,
            sin necesitar Microsoft Excel instalado. Usa una fecha de corte única, incluye datos
            actuales, históricos, futuros conocidos, Notas, movimientos, cierres, trazabilidad técnica,
            préstamos, eliminados y borradores claramente separados.
          </Paragraph>
          <List MarkerStyle="Disc">
            <ListItem><Paragraph>La carpeta es configurable y el Escritorio es el valor predeterminado.</Paragraph></ListItem>
            <ListItem><Paragraph>El nombre contiene fecha y hora; si ya existe, se añade un sufijo y nunca se sobrescribe.</Paragraph></ListItem>
            <ListItem><Paragraph>Primero se escribe un temporal. Si falla, se elimina y no queda un libro parcial.</Paragraph></ListItem>
            <ListItem><Paragraph>Los valores se escriben con tipos de fecha, dinero, porcentaje y cantidad; los textos peligrosos no se ejecutan como fórmulas.</Paragraph></ListItem>
            <ListItem><Paragraph>Exportar no modifica SQLite, no genera movimientos y no obliga a pulsar Actualizar.</Paragraph></ListItem>
          </List>
          <Paragraph>
            El Excel es una fotografía para consulta y archivo humano, pero no se puede importar ni
            restaurar. Para una copia recuperable use siempre Crear copia ahora y conserve el archivo
            .db.
          </Paragraph>

          <Paragraph x:Name="Actualizaciones" Style="{StaticResource SectionTitle}">20. Actualizaciones</Paragraph>
          <Paragraph>
            La sección Actualizaciones consulta versiones públicas del repositorio de GitHub sin
            guardar tokens personales. Puede buscar manualmente, descargar una versión publicada y
            aplicarla al cerrar o reiniciar. La administración local continúa funcionando sin
            Internet.
          </Paragraph>
          <List MarkerStyle="Disc">
            <ListItem><Paragraph>No desinstale el programa para actualizarlo.</Paragraph></ListItem>
            <ListItem><Paragraph>Los datos viven fuera de la carpeta del ejecutable y deben conservarse entre versiones.</Paragraph></ListItem>
            <ListItem><Paragraph>Antes de una prueba importante, cree además una copia manual .db.</Paragraph></ListItem>
            <ListItem><Paragraph>El instalador alpha no está firmado y Windows puede mostrar SmartScreen.</Paragraph></ListItem>
            <ListItem><Paragraph>Si la descarga o instalación falla, conserve abierta la versión actual, no desinstale ni borre datos, compruebe Internet y vuelva a Buscar actualización. Si el error persiste, cree una copia manual .db y reporte el mensaje exacto.</Paragraph></ListItem>
          </List>
          <Paragraph>
            La prueba real de actualización entre dos Releases aún está pendiente. La siguiente
            actualización prevista añadirá el logo de la empresa desde GitHub para comprobar que el
            programa se actualiza sin desinstalarse y sin borrar la información guardada. No se debe
            declarar esa prueba aprobada hasta ejecutarla y verificar la base de datos después.
          </Paragraph>

          <Paragraph Style="{StaticResource SubTitle}">Solución de problemas y glosario</Paragraph>
          <Paragraph Style="{StaticResource SubTitle}">Si una operación no se guarda</Paragraph>
          <List MarkerStyle="Disc">
            <ListItem><Paragraph>Revise campos obligatorios, fecha, selección y cantidad de decimales.</Paragraph></ListItem>
            <ListItem><Paragraph>Lea el mensaje de estado; corrija solo el campo indicado y vuelva a intentar.</Paragraph></ListItem>
            <ListItem><Paragraph>No repita la operación si ya aparece en la tabla o en Movimientos del día.</Paragraph></ListItem>
            <ListItem><Paragraph>Si la aplicación no responde, espere a que termine la operación de datos antes de intentar cerrarla nuevamente.</Paragraph></ListItem>
          </List>
          <Paragraph Style="{StaticResource SubTitle}">Conceptos esenciales</Paragraph>
          <List MarkerStyle="Disc">
            <ListItem><Paragraph><Bold>Ingreso operativo:</Bold> dinero cobrado por uso del local, ventas u otros ingresos propios.</Paragraph></ListItem>
            <ListItem><Paragraph><Bold>Financiación:</Bold> préstamos recibidos y aportes; aumenta disponibilidad, no ganancia.</Paragraph></ListItem>
            <ListItem><Paragraph><Bold>Alquiler pendiente:</Bold> cuota de silla causada que el trabajador todavía no ha pagado.</Paragraph></ListItem>
            <ListItem><Paragraph><Bold>Pago pendiente:</Bold> servicio, impuesto, obligación, crédito, cuota, gasto recurrente o mantenimiento opcional conocido que aún debe atenderse.</Paragraph></ListItem>
            <ListItem><Paragraph><Bold>Snapshot:</Bold> fotografía histórica congelada por un cierre confirmado.</Paragraph></ListItem>
            <ListItem><Paragraph><Bold>Eliminación lógica:</Bold> deja de mostrar un registro operativo sin borrar su historia.</Paragraph></ListItem>
            <ListItem><Paragraph><Bold>Borrador:</Bold> texto recuperable que aún no constituye una operación.</Paragraph></ListItem>
          </List>
          <Paragraph Margin="0,14,0,6"
                     Padding="12"
                     Background="#EEF3FF"
                     Foreground="#172033">
            Ante una duda financiera, consulte primero Resumen mensual y el módulo que originó el
            movimiento. No corrija un resultado duplicando ingresos o gastos en otra sección.
          </Paragraph>
        </FlowDocument>
      </FlowDocumentScrollViewer>
    </Border>
  </Grid>
</UserControl>
